{
  "expo": {
    "name": "Ride & Park",
    "slug": "ride-and-park-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gleezip",
    "userInterfaceStyle": "dark",

    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gleezip.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Gleezip uses your location to provide nearby ride services.",
        "NSUserNotificationsUsageDescription": "Gleezip sends ride updates and important notifications.",
        "NSCameraUsageDescription": "Gleezip uses the camera for profile photos and verification.",
        "NSPhotoLibraryUsageDescription": "Gleezip accesses your photo library for profile uploads.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.gleezip.app",
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],

      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",

      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.gleezip.app",
          "enableGooglePay": true
        }
      ],

      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "agpVersion": "8.5.2"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "apiUrl": "https://www.gleezip.com/api",
      "eas": {
        "projectId": "abf770af-6f99-43f3-9cc7-c2b354d85316"
      }
    },

    "owner": "amatip-it",

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/abf770af-6f99-43f3-9cc7-c2b354d85316"
    }
  }
}
