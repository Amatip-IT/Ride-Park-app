# Backend API Configuration
# Physical device: use your computer's LAN IPv4 (ipconfig), same Wi‑Fi as the phone — NOT localhost.
# Port must match backend .env PORT (default in this repo: 5001).
# Example: EXPO_PUBLIC_API_URL=http://192.168.3.5:5001/api
EXPO_PUBLIC_API_URL=http://192.168.3.5:5001/api

# Stripe Configuration (publishable key only; never put rk_* or sk_* keys in the app)
# Use pk_test_ locally and pk_live_ only in the production mobile build.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Amazon Location (maps)
EXPO_PUBLIC_AWS_LOCATION_KEY=your_aws_location_key_here
EXPO_PUBLIC_AWS_REGION=eu-west-2
EXPO_PUBLIC_AWS_PLACE_INDEX=AmatipPlaceIndex
