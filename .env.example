NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/gleezip

# JWT — use two different secrets in production (required)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_refresh_secret

# Production web origins (native mobile is not CORS-governed)
CORS_ORIGINS=https://admin.example.com,https://app.example.com

# ── Stripe (only these four keys) ─────────────────────────────
# DevOps replaces with live at deploy:
#   STRIPE_RESTRICTED_KEY = rk_live_...
#   STRIPE_SECRET_KEY     = sk_live_...   (optional fallback; prod prefers rk)
#   STRIPE_PUBLISHABLE_KEY = pk_live_...
#   STRIPE_WEBHOOK_SECRET  = whsec_...    (one signing secret for now)
#
# Mobile production build only needs:
#   EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_ALLOW_LIVE_MODE=false
STRIPE_RESTRICTED_KEY=rk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# SMTP verification on startup (set true only if you want a hard fail on bad mail config)
SMTP_VERIFY_ON_STARTUP=false
